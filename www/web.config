<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files><clear /><add value="default.asp" /></files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="65536" maxUrl="2048" maxQueryString="1024" />
        <hiddenSegments><add segment="includes" /></hiddenSegments>
        <fileExtensions>
          <remove fileExtension=".mdb" />
          <remove fileExtension=".accdb" />
          <remove fileExtension=".ldb" />
          <remove fileExtension=".laccdb" />
          <remove fileExtension=".ps1" />
          <remove fileExtension=".vbs" />
          <remove fileExtension=".log" />
          <add fileExtension=".mdb" allowed="false" />
          <add fileExtension=".accdb" allowed="false" />
          <add fileExtension=".ldb" allowed="false" />
          <add fileExtension=".laccdb" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".vbs" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
